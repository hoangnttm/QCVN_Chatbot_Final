# Copy to infra/.env (docker compose) and backend/.env (application). Never commit real secrets.

# --- PostgreSQL (pgvector) ---
POSTGRES_USER=qcvn
POSTGRES_PASSWORD=qcvn_dev_password
POSTGRES_DB=qcvn
POSTGRES_PORT=5432

# --- Neo4j (password must be >= 8 chars) ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=qcvn_dev_neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# --- Backend ---
DATABASE_URL=postgresql+psycopg://qcvn:qcvn_dev_password@localhost:5432/qcvn
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_DATABASE=neo4j
NEO4J_TIMEOUT_S=2
# Graph at runtime (plan 2026-09-29): neo4j | off. PPR needs the GDS plugin; both features are
# evaluation-only / observe-only until the PO decides (D31, D33)
GRAPH_BACKEND=neo4j
# Vector search: pgvector (default) | neo4j (vector index on EvidenceChunk.embedding; rebuild the
# projection with scripts/build_graph.py after every embed run)
VECTOR_BACKEND=pgvector
PPR_DAMPING=0.85
PPR_MAX_ITERATIONS=20
PPR_ENTITY_MASS=0.5
PPR_SEED_CHUNKS=10
PPR_WEIGHT=1.0
GRAPH_VERIFY_MODE=observe
# QA LLM (ADR-0011, 2026-09-23): Gemini via the same GEMINI_API_KEY; pin model ids, never "-latest"
LLM_PROVIDER=gemini
GEMINI_ANSWER_MODEL=gemini-3.8-flash
GEMINI_ANSWER_THINKING=low
GEMINI_UNDERSTANDING_MODEL=gemini-3.5-flash-lite
GEMINI_JUDGE_MODEL=gemini-3.8-flash
GEMINI_JUDGE_THINKING=high
# alternative provider (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Embeddings: Gemini API (ADR-0005, 2026-09-24). Set EMBEDDING_PROVIDER=local to use bge-m3 instead.
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536
EMBEDDING_TASK_DOCUMENT=RETRIEVAL_DOCUMENT
EMBEDDING_TASK_QUERY=RETRIEVAL_QUERY
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_CHARS=6000
# local fallback
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
# LLM reranker (evaluation-only, off by default; research plan 2026-09-28)
RERANKER_MODEL=gemini-3.5-flash-lite
RERANK_TIMEOUT_S=10
RERANK_MAX_CHARS=700
LOG_LEVEL=INFO
LOG_JSON=true
APP_VERSION=0.2.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Admin & monitoring (Phase 5) ---
# Shared admin token until real auth (M9): required for /api/v1/admin/* (header X-Admin-Token)
ADMIN_TOKEN=
GEMINI_TIMEOUT_S=60
# Quota / budget are warn-only (PO 2026-09-24): alerts + soft notice, no blocking
QUOTA_QUESTIONS_PER_CLIENT_DAY=50
QUOTA_GLOBAL_USD_PER_DAY=5.0
# Alerts: evaluated every ALERT_INTERVAL_S over the last ALERT_WINDOW_MIN minutes; webhook = Slack/Teams/Google Chat
ALERTS_ENABLED=true
ALERT_WEBHOOK_URL=
ALERT_INTERVAL_S=60
ALERT_WINDOW_MIN=15
ALERT_MIN_SAMPLES=5
ALERT_ERROR_RATE=0.2
ALERT_ABSTAIN_RATE=0.6
ALERT_VALIDATOR_REJECT_RATE=0.3
ALERT_P95_LATENCY_MS=15000
ALERT_GEMINI_CONSECUTIVE_ERRORS=3
ALERT_COOLDOWN_MIN=60
HEALTH_GEMINI_PROBE=false
HISTORY_MAX=100
QUERY_LOG_RETENTION_DAYS=365
